# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_manager

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# AI (DeepSeek via OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fallback model used by background AI passes (legacy deepseek-chat alias retired 2026-07-24)
DEEPSEEK_MODEL=deepseek-v4-flash
# V4 Pro (strongest reasoning / planning) and V4 Flash (fast & cheap workhorse)
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# Default chat model selection: auto | deepseek-v4-pro | deepseek-v4-flash
# auto = AI routes planning/onboarding to Pro and quick Q&A to Flash
MODEL_SELECTION=auto

# AI Web Research (DuckDuckGo, no API key needed). Set to false to disable.
WEB_RESEARCH_ENABLED=true

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173

# SMTP email (daily & weekly digests + worker notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="AgencyOps <no-reply@example.com>"
DIGEST_EMAIL=admin@example.com
